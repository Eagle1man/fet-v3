# Пути и настройки FET v3.
# Скопируйте в .env и поправьте под свою машину.

# Каталог с выгрузкой AVTOR (внутри — папки Rasp_* с rasp2.csv и справочниками)
AVTOR_OUT=D:\AVTOR_CLEAN_20260917_153823\OUT

# Каталог проекта v3
FETV3_DB=D:\FET_v3\data\schedule.db
FETV3_OUT=D:\FET_v3\out

# FET 7.10.5 (fet-cl.exe). Пусто — валидация по бинарнику пропускается.
FET_CL=C:\Users\diorl\.cline\data\workspaces\chat\fet_raspisanie\tools\fet-app\fet-7.10.5\fet-cl.exe

# Название учреждения в .fet
FETV3_SCHOOL=Южный университет (ИУБиП)

# Лимит времени генерации FET при проверке, секунд
FET_CL_TIMELIMIT=180

# Вместимость аудиторий: в выгрузке AVTOR её нет. 999 = «не ограничивать».
FETV3_ROOM_CAPACITY=999

# Ручные ограничения недоступности (JSON). Пусто — не используются.
FETV3_CONSTRAINTS=

# Локальный ИИ-ассистент (только Ollama, без облака)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=180
AI_MAX_STEPS=8

# Веб-панель для ВМ
# Пароль администратора. Пусто — панель открыта всем (только для отладки).
FETV3_WEB_PASSWORD=
FETV3_WEB_SECRET=replace-with-random-string
# Разрешить чтение без входа (публичная страница расписания)
FETV3_PUBLIC_READ=false
# Академия по умолчанию для выгрузки на сайт
FETV3_SITE_FACULTY=Колледж
# Снимок групп сайта для сопоставления «группа → академия» (необязательно)
FETV3_SITE_GROUPS=config/site_groups.json
# FTP вуза для публикации (пусто — только архив)
FETV3_FTP_HOST=
FETV3_FTP_USER=
FETV3_FTP_PASSWORD=
FETV3_FTP_DIR=

# CORS для API (если сайт вуза обращается к панели напрямую)
FETV3_CORS_ORIGINS=
