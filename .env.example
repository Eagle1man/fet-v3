# Пути и настройки FET v3.
# Скопируйте в .env и поправьте под свою машину.

# Каталог с выгрузкой AVTOR (внутри — папки Rasp_* с rasp2.csv и справочниками)
AVTOR_OUT=D:\AVTOR_CLEAN_20260917_153823\OUT

# Каталог проекта v3
FETV3_DB=D:\FET_v3\data\schedule.db
FETV3_OUT=D:\FET_v3\out

# FET 7.10.5 (fet-cl.exe). Пусто — валидация по бинарнику пропускается.
FET_CL=C:\Users\diorl\.cline\data\workspaces\chat\fet_raspisanie\tools\fet-app\fet-7.10.5\fet-cl.exe

# Название учреждения в .fet
FETV3_SCHOOL=Южный университет (ИУБиП)

# Лимит времени генерации FET при проверке, секунд
FET_CL_TIMELIMIT=180

# Вместимость аудиторий: в выгрузке AVTOR её нет. 999 = «не ограничивать».
FETV3_ROOM_CAPACITY=999

# Ручные ограничения недоступности (JSON). Пусто — не используются.
FETV3_CONSTRAINTS=
